# ============================================================================
# Caddyfile — «СменаПринята» (T13)
# Место на сервере: /etc/caddy/Caddyfile   (Caddy v2, официальный репозиторий)
#
# ПЕРЕД ВЫКАТОМ:
#   1. Заменить {DOMAIN} на реальный домен (A-запись уже должна смотреть на VPS).
#      {DOMAIN} — текстовая метка для ручной замены (sed -i), НЕ плейсхолдер
#      Caddy: с ней caddy validate будет ругаться — сначала замена, потом validate.
#   2. Положить рядом страницу ошибки:  sudo cp 502.html /etc/caddy/502.html
#   3. Проверить конфигурацию:
#        sudo caddy validate --config /etc/caddy/Caddyfile
#      (в т.ч. блок timeouts ниже — синтаксис сверен с документацией Caddy v2,
#       но перед выкатом validate обязателен).
# ============================================================================

{
	# Таймауты HTTP-серверов (NFR-1 ТЗ: запрос длиннее ~10 с прерывается,
	# пользователь получает UPSTREAM_DOWN). Синтаксис — глобальный options-блок
	# servers { timeouts { ... } } со стандартными директивами Caddy v2:
	# read_header, read_body, write.
	# !!! Проверить `sudo caddy validate --config /etc/caddy/Caddyfile`
	# !!! перед выкатом.
	servers {
		timeouts {
			read_header 10s
			read_body 10s
			write 10s
		}
	}

	# E-mail для ACME (уведомления Let's Encrypt о выпуске/истечении сертификатов).
	# Не обязательно, но рекомендуется; не забудьте заменить на реальный после
	# подстановки домена:
	# email admin@example.com
}

{DOMAIN} {
	# Редирект http -> https — ПОВЕДЕНИЕ Caddy ПО УМОЛЧАНИЮ (Automatic HTTPS):
	# при адресе сайта без схемы Caddy сам выпускает сертификат Let's Encrypt
	# (HTTP-01, нужен порт 80) и отдаёт 308-редирект с http на https.
	# Отдельная директива redir НЕ нужна.

	# Ограничение тела запроса: 64 КиБ по ТЗ. Больше — HTTP 413 от Caddy,
	# до приложения запрос не дойдёт.
	max_body 65536

	# Обратный прокси на приложение (uvicorn слушает только 127.0.0.1:8000,
	# наружу из VPS торчит только Caddy на 80/443).
	reverse_proxy 127.0.0.1:8000 {
		# NFR-1: приложение не ответило за 10 с — прерываем и отдаём 502.
		# response_header_timeout — опция транспорта http (ожидание
		# заголовков ответа от бэкенда), валидна в Caddy v2.
		transport http {
			response_header_timeout 10s
		}
	}

	# Страница «сервер недоступен» — 502 UPSTREAM_DOWN (текст по таблице ошибок ТЗ).
	#
	# Как это работает в Caddy v2:
	#  * Когда Caddy НЕ получил ответ приложения (upstream down, отказ в
	#    соединении, обрыв, таймаут), reverse_proxy сам порождает ошибку с
	#    кодом 502 (реже 503) — она уходит в handle_errors.
	#  * Когда приложение вернуло 502/503 САМО (ответ дошёл), это обычный
	#    ответ бэкенда — handle_errors его не перехватывает. Это корректно
	#    по ТЗ: на 500/503 приложение само отдаёт INTERNAL_ERROR со своим
	#    шаблоном.
	#  * У reverse_proxy в Caddy v2 нет субдирективы, перехватывающей сам
	#    отказ бэкенда и отдающей файл: `handle_response`/`replace_status`
	#    работают только с ОТВЕТАМИ бэкенда (а здесь ответа нет). Поэтому
	#    для статической страницы используется документированная связка
	#    handle_errors + rewrite + file_server (рекомендация из документации
	#    Caddy по кастомным error-страницам). Вариант `respond` внутри
	#    handle_errors тоже рабочий, но отдаёт только литеральный текст —
	#    весь HTML страницы пришлось бы инлайнить одной строкой.
	#  * file_server внутри handle_errors СОХРАНЯЕТ код ошибки (документация
	#    Caddy: «file_server preserves the error's HTTP status code when run
	#    in handle_errors») — ответ уходит с 502, отдельная подстановка кода
	#    не нужна (субдирективы status у file_server нет).
	handle_errors 502 503 {
		root * /etc/caddy
		rewrite * /502.html
		header Content-Type "text/html; charset=utf-8"
		file_server
	}
}
