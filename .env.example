# Пример конфигурации окружения (имена — по таблице «Конфигурация» ТЗ v1.1.2).
# Скопировать в .env (не коммитить!) и заполнить значения.
# На VPS переменные задаются в systemd unit (Environment=...) —
# .env используется только для локальной разработки.

# ОБЯЗАТЕЛЕН: ключ подписи cookie-сессий.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Файл SQLite. Прод: /var/lib/smena/smena.db; для разработки удобно относительный.
DATABASE_PATH=data/smena.db

# Пилот (дней) и лимит активных учётных записей на отель (FR-A3)
TRIAL_DAYS=14
ACCOUNT_LIMIT=10

# Пороги (A-5): просрочка непринятой смены; «затянувшийся» вопрос
PENDING_OVERDUE_HOURS=12
ISSUE_STALE_HOURS=24
ISSUE_STALE_CARRIES=2

# Часовой пояс по умолчанию при регистрации отеля (должен быть в config/timezones.txt)
DEFAULT_TIMEZONE=Asia/Novosibirsk

# Внешнее хранилище копий rclone (обязателен до T12; без значения backup.sh падает)
BACKUP_REMOTE=
