# Пример конфигурации окружения.
# Скопировать в .env (не коммитить!) и заполнить значениями.
# На VPS переменные задаются в systemd unit (Environment=...) —
# .env используется для локальной разработки.

# Путь к базе SQLite (относительный — от корня проекта)
DATABASE_URL=sqlite:///data/smena.db

# Секретный ключ для подписанных сессий (cookie).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Режим отладки: 0 (прод) | 1 (разработка). В проде только 0.
DEBUG=0

# Пилот: количество дней с момента активации отеля (FR пилота, set_paid вручную)
PILOT_DAYS=14

# Лимит активных записей в журнале на отель
MAX_ACTIVE_ISSUES=10
